{
  "$defs": {
    "host": {"additionalProperties": false, "properties": {"architecture": {"$ref": "#/$defs/id"}, "claude_code_version": {"pattern": "^[0-9]+[0-9A-Za-z._-]*$", "type": "string"}, "executable_path": {"maxLength": 240, "minLength": 1, "type": "string"}, "executable_resolved_path": {"maxLength": 240, "minLength": 1, "type": "string"}, "executable_sha256": {"$ref": "#/$defs/sha256"}, "operating_system": {"$ref": "#/$defs/id"}}, "required": ["claude_code_version", "executable_path", "executable_resolved_path", "executable_sha256", "operating_system", "architecture"], "type": "object"},
    "id": {"pattern": "^[a-z][a-z0-9_-]{2,63}$", "type": "string"},
    "inspected_or_absent_source": {"oneOf": [{"properties": {"canonical_sha256": {"type": "null"}, "inspection_status": {"const": "confirmed_absent_safe_metadata"}, "present": {"const": false}, "raw_sha256": {"type": "null"}}, "required": ["present", "inspection_status", "raw_sha256", "canonical_sha256"]}, {"properties": {"canonical_sha256": {"$ref": "#/$defs/sha256"}, "inspection_status": {"const": "inspected_safe_settings"}, "present": {"const": true}, "raw_sha256": {"$ref": "#/$defs/sha256"}}, "required": ["present", "inspection_status", "raw_sha256", "canonical_sha256"]}]},
    "nonselected_candidate": {"additionalProperties": false, "properties": {"bounded_path_hint": {"maxLength": 240, "minLength": 1, "type": "string"}, "candidate_id": {"$ref": "#/$defs/id"}, "location_class": {"enum": ["project", "system_temporary", "user_cache", "user_state"], "type": "string"}, "outcome": {"enum": ["rejected", "unverified"], "type": "string"}, "reason_codes": {"items": {"$ref": "#/$defs/id"}, "maxItems": 32, "minItems": 1, "type": "array", "uniqueItems": true}, "static_checks": {"items": {"$ref": "#/$defs/id"}, "minItems": 1, "type": "array", "uniqueItems": true}}, "required": ["candidate_id", "location_class", "bounded_path_hint", "outcome", "reason_codes", "static_checks"], "type": "object"},
    "nullable_sha256": {"pattern": "^[0-9a-f]{64}$", "type": ["null", "string"]},
    "permission_evaluator": {"additionalProperties": false, "properties": {"execution_status": {"enum": ["executed", "not_executed_provider_free_path_unavailable"], "type": "string"}, "identity": {"$ref": "#/$defs/id"}, "static_evidence": {"items": {"$ref": "#/$defs/id"}, "maxItems": 32, "minItems": 1, "type": "array", "uniqueItems": true}, "unproven_capabilities": {"items": {"$ref": "#/$defs/id"}, "type": "array", "uniqueItems": true}}, "required": ["identity", "execution_status", "static_evidence", "unproven_capabilities"], "type": "object"},
    "selected_candidate": {"additionalProperties": false, "properties": {"candidate_id": {"$ref": "#/$defs/id"}, "location_class": {"const": "system_temporary", "type": "string"}, "outcome": {"const": "selected", "type": "string"}, "root_path": {"maxLength": 240, "minLength": 36, "pattern": "^/private/tmp/contextguard-broker/[a-z][a-z0-9_-]{2,63}$", "type": "string"}, "verification": {"$ref": "#/$defs/selected_root_verification"}}, "required": ["candidate_id", "location_class", "root_path", "outcome", "verification"], "type": "object"},
    "selected_root_verification": {"additionalProperties": false, "properties": {"attempt_specific": {"const": true, "type": "boolean"}, "bounded_cleanup_enforced": {"const": true, "type": "boolean"}, "existing_deny_precedence_proven": {"const": true, "type": "boolean"}, "git_workspace_excluded": {"const": true, "type": "boolean"}, "narrow_readability_proven": {"const": true, "type": "boolean"}, "non_symlinked_components": {"const": true, "type": "boolean"}, "owner_only_mode_enforced": {"const": true, "type": "boolean"}, "unrelated_read_tool_excluded": {"const": true, "type": "boolean"}}, "required": ["attempt_specific", "bounded_cleanup_enforced", "existing_deny_precedence_proven", "git_workspace_excluded", "narrow_readability_proven", "non_symlinked_components", "owner_only_mode_enforced", "unrelated_read_tool_excluded"], "type": "object"},
    "selected_tuple": {"additionalProperties": false, "properties": {"selected_candidate": {"$ref": "#/$defs/selected_candidate"}}, "required": ["selected_candidate"], "type": "object"},
    "settings": {"additionalProperties": false, "oneOf": [{"properties": {"effective_settings_sha256": {"$ref": "#/$defs/nullable_sha256"}, "source_inventory_complete": {"const": false}}, "required": ["effective_settings_sha256", "source_inventory_complete"]}, {"properties": {"effective_settings_sha256": {"$ref": "#/$defs/sha256"}, "source_inventory_complete": {"const": true}, "sources": {"allOf": [{"$ref": "#/$defs/settings_sources"}, {"properties": {"local": {"$ref": "#/$defs/inspected_or_absent_source"}, "managed": {"$ref": "#/$defs/inspected_or_absent_source"}, "project": {"$ref": "#/$defs/inspected_or_absent_source"}, "user": {"$ref": "#/$defs/inspected_or_absent_source"}}, "required": ["local", "managed", "project", "user"]}]}}, "required": ["effective_settings_sha256", "source_inventory_complete", "sources"]}], "properties": {"effective_settings_sha256": {"$ref": "#/$defs/nullable_sha256"}, "evaluation_note": {"maxLength": 240, "minLength": 1, "type": "string"}, "source_inventory_complete": {"type": "boolean"}, "sources": {"$ref": "#/$defs/settings_sources"}}, "required": ["effective_settings_sha256", "evaluation_note", "source_inventory_complete", "sources"], "type": "object"},
    "settings_source": {"additionalProperties": false, "oneOf": [{"properties": {"canonical_sha256": {"type": "null"}, "inspection_status": {"const": "confirmed_absent_safe_metadata"}, "present": {"const": false}, "raw_sha256": {"type": "null"}}, "required": ["present", "inspection_status", "raw_sha256", "canonical_sha256"]}, {"properties": {"canonical_sha256": {"$ref": "#/$defs/sha256"}, "inspection_status": {"const": "inspected_safe_settings"}, "present": {"const": true}, "raw_sha256": {"$ref": "#/$defs/sha256"}}, "required": ["present", "inspection_status", "raw_sha256", "canonical_sha256"]}, {"properties": {"canonical_sha256": {"type": "null"}, "inspection_status": {"enum": ["not_inspected_secret_boundary", "unavailable_safe_metadata_only"]}, "present": {"const": true}, "raw_sha256": {"type": "null"}}, "required": ["present", "inspection_status", "raw_sha256", "canonical_sha256"]}], "properties": {"canonical_sha256": {"$ref": "#/$defs/nullable_sha256"}, "inspection_status": {"enum": ["confirmed_absent_safe_metadata", "inspected_safe_settings", "not_inspected_secret_boundary", "unavailable_safe_metadata_only"], "type": "string"}, "present": {"type": "boolean"}, "raw_sha256": {"$ref": "#/$defs/nullable_sha256"}, "source_kind": {"enum": ["local", "managed", "project", "user"], "type": "string"}}, "required": ["source_kind", "present", "inspection_status", "raw_sha256", "canonical_sha256"], "type": "object"},
    "settings_sources": {"additionalProperties": false, "properties": {"local": {"allOf": [{"$ref": "#/$defs/settings_source"}, {"properties": {"source_kind": {"const": "local"}}, "required": ["source_kind"]}]}, "managed": {"allOf": [{"$ref": "#/$defs/settings_source"}, {"properties": {"source_kind": {"const": "managed"}}, "required": ["source_kind"]}]}, "project": {"allOf": [{"$ref": "#/$defs/settings_source"}, {"properties": {"source_kind": {"const": "project"}}, "required": ["source_kind"]}]}, "user": {"allOf": [{"$ref": "#/$defs/settings_source"}, {"properties": {"source_kind": {"const": "user"}}, "required": ["source_kind"]}]}}, "required": ["local", "managed", "project", "user"], "type": "object"},
    "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "$id": "artifact-root-permission-decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "oneOf": [
    {"properties": {"permission_evaluator": {"properties": {"execution_status": {"const": "executed"}, "identity": {"const": "installed_claude_code_permission_evaluator"}, "static_evidence": {"items": {"enum": ["candidate_permission_matrix_verified", "installed_permission_evaluator_executed", "settings_semantics_evaluated"]}, "maxItems": 3, "minItems": 3, "uniqueItems": true}, "unproven_capabilities": {"maxItems": 0}}, "required": ["identity", "execution_status", "static_evidence", "unproven_capabilities"]}, "rejection_reason_codes": {"maxItems": 0}, "selected_tuple": {"$ref": "#/$defs/selected_tuple"}, "settings": {"properties": {"source_inventory_complete": {"const": true}}, "required": ["source_inventory_complete"]}, "status": {"const": "selected"}}, "required": ["status", "selected_tuple", "rejection_reason_codes", "permission_evaluator", "settings"]},
    {"properties": {"rejection_reason_codes": {"minItems": 1}, "selected_tuple": {"type": "null"}, "status": {"const": "transport_rejected"}}, "required": ["status", "selected_tuple", "rejection_reason_codes"]}
  ],
  "properties": {
    "attempt_id": {"$ref": "#/$defs/id"},
    "candidates": {"items": {"$ref": "#/$defs/nonselected_candidate"}, "maxItems": 16, "minItems": 4, "type": "array", "uniqueItems": true},
    "decision_id": {"$ref": "#/$defs/id"},
    "frozen_at_utc": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"},
    "host": {"$ref": "#/$defs/host"},
    "network_used": {"const": false, "type": "boolean"},
    "permission_evaluator": {"$ref": "#/$defs/permission_evaluator"},
    "provider_called": {"const": false, "type": "boolean"},
    "rejection_reason_codes": {"items": {"$ref": "#/$defs/id"}, "maxItems": 32, "type": "array", "uniqueItems": true},
    "schema_version": {"const": "v1", "type": "string"},
    "selected_tuple": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/selected_tuple"}]},
    "settings": {"$ref": "#/$defs/settings"},
    "settings_modified": {"const": false, "type": "boolean"},
    "status": {"enum": ["selected", "transport_rejected"], "type": "string"}
  },
  "required": ["schema_version", "attempt_id", "decision_id", "frozen_at_utc", "status", "host", "settings", "permission_evaluator", "candidates", "selected_tuple", "rejection_reason_codes", "network_used", "provider_called", "settings_modified"],
  "title": "Artifact root permission decision",
  "type": "object"
}
