{
  "$defs": {
    "eligibility_reason": {"enum": ["BUDGET_OR_MATERIALIZATION_FAILURE", "DESCRIPTOR_MISSING", "EMPTY_SELECTION", "INDEX_UNAVAILABLE", "INELIGIBLE_STRATUM", "PROTECTED_CLASSIFIER_UNAVAILABLE_PRE_ACTIVATION", "STALE_AUTHORIZATION_PRE_PROTECTED_ACCESS", "UNSUPPORTED_HOST"], "type": "string"},
    "evidence_reason": {"enum": ["COST_EVIDENCE_GAP", "CROSS_ARM_LEAKAGE", "POST_ACTIVATION_HOOK_FAILURE", "PROVIDER_JOIN_MISSING", "QUALITY_EVIDENCE_GAP", "READ_OBSERVATION_MISSING", "READ_OBSERVATION_TRUNCATED", "RECEIPT_DURABILITY_UNCERTAIN", "RESET_MISMATCH"], "type": "string"},
    "freshness_reason": {"enum": ["AUTHORIZATION_FRESHNESS_MISMATCH", "CANDIDATE_UNIVERSE_MISMATCH", "DIRTY_STATE_MISMATCH", "INDEX_FRESHNESS_MISMATCH", "SOURCE_FRESHNESS_MISMATCH"], "type": "string"},
    "id": {"pattern": "^[a-z][a-z0-9_-]{2,63}$", "type": "string"},
    "nullable_id": {"pattern": "^[a-z][a-z0-9_-]{2,63}$", "type": ["null", "string"]},
    "pre_security_reason": {"enum": ["PACK_HASH_MISMATCH", "PERMISSION_AMBIGUITY", "SECRET_OR_PROTECTED_PATH_MATCH", "SYMLINK_OR_ROOT_ESCAPE", "UNSAFE_ARTIFACT_ROOT"], "type": "string"},
    "reason_code": {"enum": ["AUTHORIZATION_FRESHNESS_MISMATCH", "BUDGET_OR_MATERIALIZATION_FAILURE", "CANDIDATE_UNIVERSE_MISMATCH", "COST_EVIDENCE_GAP", "CROSS_ARM_LEAKAGE", "DESCRIPTOR_MISSING", "DIRTY_STATE_MISMATCH", "EMPTY_SELECTION", "INDEX_FRESHNESS_MISMATCH", "INDEX_UNAVAILABLE", "INELIGIBLE_STRATUM", "PACK_HASH_MISMATCH", "PERMISSION_AMBIGUITY", "POST_ACTIVATION_HOOK_FAILURE", "PROTECTED_CLASSIFIER_UNAVAILABLE_AFTER_ACTIVATION", "PROTECTED_CLASSIFIER_UNAVAILABLE_PRE_ACTIVATION", "PROVIDER_JOIN_MISSING", "QUALITY_EVIDENCE_GAP", "READ_OBSERVATION_MISSING", "READ_OBSERVATION_TRUNCATED", "RECEIPT_DURABILITY_UNCERTAIN", "RESET_MISMATCH", "SECRET_OR_PROTECTED_PATH_MATCH", "SOURCE_FRESHNESS_MISMATCH", "STALE_AUTHORIZATION_PRE_PROTECTED_ACCESS", "SYMLINK_OR_ROOT_ESCAPE", "UNSAFE_ARTIFACT_ROOT", "UNSUPPORTED_HOST"], "type": "string"},
    "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "$id": "decision-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "oneOf": [
    {"properties": {"action": {"const": "BLOCK_TOOL"}, "activation_status": {"const": "not_activated"}, "claim_blockers": {"contains": {"$ref": "#/$defs/pre_security_reason"}, "items": {"enum": ["AUTHORIZATION_FRESHNESS_MISMATCH", "BUDGET_OR_MATERIALIZATION_FAILURE", "CANDIDATE_UNIVERSE_MISMATCH", "DESCRIPTOR_MISSING", "DIRTY_STATE_MISMATCH", "EMPTY_SELECTION", "INDEX_FRESHNESS_MISMATCH", "INDEX_UNAVAILABLE", "INELIGIBLE_STRATUM", "PACK_HASH_MISMATCH", "PERMISSION_AMBIGUITY", "PROTECTED_CLASSIFIER_UNAVAILABLE_PRE_ACTIVATION", "SECRET_OR_PROTECTED_PATH_MATCH", "SOURCE_FRESHNESS_MISMATCH", "STALE_AUTHORIZATION_PRE_PROTECTED_ACCESS", "SYMLINK_OR_ROOT_ESCAPE", "UNSAFE_ARTIFACT_ROOT", "UNSUPPORTED_HOST"]}, "type": "array"}, "phase": {"const": "pre_activation"}}, "required": ["action", "activation_status", "claim_blockers", "phase"]},
    {"properties": {"action": {"const": "BLOCK_TOOL"}, "activation_status": {"const": "activated"}, "claim_blockers": {"contains": {"enum": ["PACK_HASH_MISMATCH", "PERMISSION_AMBIGUITY", "PROTECTED_CLASSIFIER_UNAVAILABLE_AFTER_ACTIVATION", "SECRET_OR_PROTECTED_PATH_MATCH", "SYMLINK_OR_ROOT_ESCAPE", "UNSAFE_ARTIFACT_ROOT"]}, "items": {"enum": ["AUTHORIZATION_FRESHNESS_MISMATCH", "CANDIDATE_UNIVERSE_MISMATCH", "COST_EVIDENCE_GAP", "CROSS_ARM_LEAKAGE", "DIRTY_STATE_MISMATCH", "INDEX_FRESHNESS_MISMATCH", "PACK_HASH_MISMATCH", "PERMISSION_AMBIGUITY", "POST_ACTIVATION_HOOK_FAILURE", "PROTECTED_CLASSIFIER_UNAVAILABLE_AFTER_ACTIVATION", "PROVIDER_JOIN_MISSING", "QUALITY_EVIDENCE_GAP", "READ_OBSERVATION_MISSING", "READ_OBSERVATION_TRUNCATED", "RECEIPT_DURABILITY_UNCERTAIN", "RESET_MISMATCH", "SECRET_OR_PROTECTED_PATH_MATCH", "SOURCE_FRESHNESS_MISMATCH", "SYMLINK_OR_ROOT_ESCAPE", "UNSAFE_ARTIFACT_ROOT"]}, "type": "array"}, "phase": {"const": "post_activation"}}, "required": ["action", "activation_status", "claim_blockers", "phase"]},
    {"properties": {"action": {"const": "BLOCK_TOOL"}, "activation_status": {"const": "activated"}, "claim_blockers": {"contains": {"$ref": "#/$defs/freshness_reason"}, "items": {"enum": ["AUTHORIZATION_FRESHNESS_MISMATCH", "CANDIDATE_UNIVERSE_MISMATCH", "COST_EVIDENCE_GAP", "CROSS_ARM_LEAKAGE", "DIRTY_STATE_MISMATCH", "INDEX_FRESHNESS_MISMATCH", "POST_ACTIVATION_HOOK_FAILURE", "PROVIDER_JOIN_MISSING", "QUALITY_EVIDENCE_GAP", "READ_OBSERVATION_MISSING", "READ_OBSERVATION_TRUNCATED", "RECEIPT_DURABILITY_UNCERTAIN", "RESET_MISMATCH", "SOURCE_FRESHNESS_MISMATCH"]}, "type": "array"}, "phase": {"const": "post_activation"}, "reread_attempts": {"const": 1}}, "required": ["action", "activation_status", "claim_blockers", "phase", "reread_attempts"]},
    {"properties": {"action": {"const": "CLAIM_BLOCK_ONLY"}, "activation_status": {"const": "activated"}, "claim_blockers": {"items": {"$ref": "#/$defs/evidence_reason"}, "type": "array"}, "phase": {"const": "post_activation"}}, "required": ["action", "activation_status", "claim_blockers", "phase"]},
    {"properties": {"action": {"const": "PASS_THROUGH_UNCHANGED"}, "activation_status": {"enum": ["bypassed", "not_activated"]}, "claim_blockers": {"items": {"$ref": "#/$defs/eligibility_reason"}, "type": "array"}, "phase": {"const": "pre_activation"}}, "required": ["action", "activation_status", "claim_blockers", "phase"]},
    {"properties": {"action": {"const": "PASS_THROUGH_UNCHANGED"}, "activation_status": {"enum": ["bypassed", "not_activated"]}, "claim_blockers": {"contains": {"$ref": "#/$defs/freshness_reason"}, "items": {"enum": ["AUTHORIZATION_FRESHNESS_MISMATCH", "BUDGET_OR_MATERIALIZATION_FAILURE", "CANDIDATE_UNIVERSE_MISMATCH", "DESCRIPTOR_MISSING", "DIRTY_STATE_MISMATCH", "EMPTY_SELECTION", "INDEX_FRESHNESS_MISMATCH", "INDEX_UNAVAILABLE", "INELIGIBLE_STRATUM", "PROTECTED_CLASSIFIER_UNAVAILABLE_PRE_ACTIVATION", "SOURCE_FRESHNESS_MISMATCH", "STALE_AUTHORIZATION_PRE_PROTECTED_ACCESS", "UNSUPPORTED_HOST"]}, "type": "array"}, "phase": {"const": "pre_activation"}, "reread_attempts": {"const": 1}}, "required": ["action", "activation_status", "claim_blockers", "phase", "reread_attempts"]},
    {"properties": {"action": {"const": "REREAD_THEN_DECIDE"}, "activation_status": {"const": "not_activated"}, "claim_blockers": {"contains": {"$ref": "#/$defs/freshness_reason"}, "items": {"enum": ["AUTHORIZATION_FRESHNESS_MISMATCH", "BUDGET_OR_MATERIALIZATION_FAILURE", "CANDIDATE_UNIVERSE_MISMATCH", "DESCRIPTOR_MISSING", "DIRTY_STATE_MISMATCH", "EMPTY_SELECTION", "INDEX_FRESHNESS_MISMATCH", "INDEX_UNAVAILABLE", "INELIGIBLE_STRATUM", "PROTECTED_CLASSIFIER_UNAVAILABLE_PRE_ACTIVATION", "SOURCE_FRESHNESS_MISMATCH", "STALE_AUTHORIZATION_PRE_PROTECTED_ACCESS", "UNSUPPORTED_HOST"]}, "type": "array"}, "phase": {"const": "pre_activation"}, "reread_attempts": {"const": 0}}, "required": ["action", "activation_status", "claim_blockers", "phase", "reread_attempts"]},
    {"properties": {"action": {"const": "REREAD_THEN_DECIDE"}, "activation_status": {"const": "activated"}, "claim_blockers": {"contains": {"$ref": "#/$defs/freshness_reason"}, "items": {"enum": ["AUTHORIZATION_FRESHNESS_MISMATCH", "CANDIDATE_UNIVERSE_MISMATCH", "COST_EVIDENCE_GAP", "CROSS_ARM_LEAKAGE", "DIRTY_STATE_MISMATCH", "INDEX_FRESHNESS_MISMATCH", "POST_ACTIVATION_HOOK_FAILURE", "PROVIDER_JOIN_MISSING", "QUALITY_EVIDENCE_GAP", "READ_OBSERVATION_MISSING", "READ_OBSERVATION_TRUNCATED", "RECEIPT_DURABILITY_UNCERTAIN", "RESET_MISMATCH", "SOURCE_FRESHNESS_MISMATCH"]}, "type": "array"}, "phase": {"const": "post_activation"}, "reread_attempts": {"const": 0}}, "required": ["action", "activation_status", "claim_blockers", "phase", "reread_attempts"]}
  ],
  "properties": {
    "action": {"enum": ["BLOCK_TOOL", "CLAIM_BLOCK_ONLY", "PASS_THROUGH_UNCHANGED", "REREAD_THEN_DECIDE"], "type": "string"},
    "activation_status": {"enum": ["activated", "bypassed", "not_activated"], "type": "string"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "claim_blockers": {"items": {"$ref": "#/$defs/reason_code"}, "maxItems": 32, "minItems": 1, "type": "array", "uniqueItems": true},
    "decision_id": {"$ref": "#/$defs/id"},
    "decision_sha256": {"$ref": "#/$defs/sha256"},
    "descriptor_id": {"$ref": "#/$defs/nullable_id"},
    "phase": {"enum": ["post_activation", "pre_activation"], "type": "string"},
    "receipt_id": {"$ref": "#/$defs/id"},
    "reread_attempts": {"maximum": 1, "minimum": 0, "type": "integer"},
    "schema_version": {"const": "v1", "type": "string"},
    "selection_snapshot_id": {"$ref": "#/$defs/nullable_id"}
  },
  "required": ["schema_version", "receipt_id", "decision_id", "decision_sha256", "attempt_id", "descriptor_id", "selection_snapshot_id", "phase", "action", "claim_blockers", "activation_status", "reread_attempts"],
  "title": "Broker decision receipt",
  "type": "object"
}
