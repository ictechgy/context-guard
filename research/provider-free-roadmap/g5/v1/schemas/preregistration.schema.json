            "rounding": {
              "const": "none_exact_rational",
              "type": "string"
            },
            "signed_mean_formula": {
              "const": "for_each_of_8_sign_vectors_compute_exact_rational_sum_of_sign_times_three_lineage_means_divided_by_3",
