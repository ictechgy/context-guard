{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "arm": {"enum": ["ordinary", "adaptive_only", "symbol_only", "combined"], "type": "string"},
    "hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "identity": {"additionalProperties": false, "properties": {"bytes": {"minimum": 0, "type": "integer"}, "sha256": {"$ref": "#/$defs/hash"}}, "required": ["bytes", "sha256"], "type": "object"},
    "sealed_json": {"additionalProperties": false, "properties": {"bytes": {"minimum": 0, "type": "integer"}, "canonical_base64": {"minLength": 4, "type": "string"}, "sha256": {"$ref": "#/$defs/hash"}}, "required": ["bytes", "canonical_base64", "sha256"], "type": "object"},
    "range": {"additionalProperties": false, "properties": {"end": {"minimum": 1, "type": "integer"}, "start": {"minimum": 1, "type": "integer"}}, "required": ["end", "start"], "type": "object"},
    "source": {"additionalProperties": false, "properties": {"label": {"type": "string"}, "path": {"minLength": 1, "type": "string"}, "priority": {"minimum": 0, "type": "integer"}, "range": {"$ref": "#/$defs/range"}, "slice": {"$ref": "#/$defs/identity"}, "source": {"$ref": "#/$defs/identity"}}, "required": ["label", "path", "priority", "range", "slice", "source"], "type": "object"},
    "context_item": {"additionalProperties": false, "properties": {"origin_event_id": {"$ref": "#/$defs/hash"}, "path": {"minLength": 1, "type": "string"}, "range": {"$ref": "#/$defs/range"}, "slice": {"$ref": "#/$defs/identity"}, "source": {"$ref": "#/$defs/identity"}}, "required": ["origin_event_id", "path", "range", "slice", "source"], "type": "object"},
    "plan_step": {"additionalProperties": false, "properties": {"kind": {"enum": ["retrieval", "fallback", "correction"], "type": "string"}, "path": {"minLength": 1, "type": "string"}, "range": {"$ref": "#/$defs/range"}, "slice": {"$ref": "#/$defs/identity"}, "source": {"$ref": "#/$defs/identity"}}, "required": ["kind", "path", "range", "slice", "source"], "type": "object"},
    "plan": {"additionalProperties": false, "properties": {"closed_world": {"const": true, "type": "boolean"}, "fixture_tree_sha256": {"$ref": "#/$defs/hash"}, "steps": {"items": {"$ref": "#/$defs/plan_step"}, "type": "array"}, "task_id": {"$ref": "#/$defs/task"}}, "required": ["closed_world", "fixture_tree_sha256", "steps", "task_id"], "type": "object"},
    "retrieval_event": {"additionalProperties": false, "properties": {"arm": {"$ref": "#/$defs/arm"}, "event_id": {"$ref": "#/$defs/hash"}, "kind": {"enum": ["retrieval", "fallback", "correction"], "type": "string"}, "ordinal": {"minimum": 1, "type": "integer"}, "path": {"minLength": 1, "type": "string"}, "plan_sha256": {"$ref": "#/$defs/hash"}, "range": {"$ref": "#/$defs/range"}, "returned_bytes": {"minimum": 0, "type": "integer"}, "round_id": {"$ref": "#/$defs/hash"}, "slice": {"$ref": "#/$defs/identity"}, "source": {"$ref": "#/$defs/identity"}, "status": {"enum": ["added", "already_present"], "type": "string"}, "task_id": {"$ref": "#/$defs/task"}}, "required": ["arm", "event_id", "kind", "ordinal", "path", "plan_sha256", "range", "returned_bytes", "round_id", "slice", "source", "status", "task_id"], "type": "object"},
    "component_formulas": {"additionalProperties": false, "properties": {"correction": {"type": "string"}, "fallback": {"type": "string"}, "fixed_overhead": {"type": "string"}, "initial_packing": {"type": "string"}, "retrieval": {"type": "string"}}, "required": ["correction", "fallback", "fixed_overhead", "initial_packing", "retrieval"], "type": "object"},
    "components": {"additionalProperties": false, "properties": {"correction": {"minimum": 0, "type": "integer"}, "fallback": {"minimum": 0, "type": "integer"}, "fixed_overhead": {"minimum": 0, "type": "integer"}, "initial_packing": {"minimum": 0, "type": "integer"}, "retrieval": {"minimum": 0, "type": "integer"}}, "required": ["correction", "fallback", "fixed_overhead", "initial_packing", "retrieval"], "type": "object"},
    "cost": {"additionalProperties": false, "properties": {"component_formulas": {"$ref": "#/$defs/component_formulas"}, "components": {"$ref": "#/$defs/components"}, "formula": {"type": "string"}, "total": {"minimum": 0, "type": "integer"}, "units": {"const": "byte_equivalent_units", "type": "string"}}, "required": ["component_formulas", "components", "formula", "total", "units"], "type": "object"},
    "captured_inputs": {"additionalProperties": false, "properties": {"g2_lock": {"$ref": "#/$defs/identity"}, "g2_packer": {"$ref": "#/$defs/identity"}, "g2_public_snapshot": {"$ref": "#/$defs/identity"}, "g3_cost_model": {"$ref": "#/$defs/identity"}, "g3_schema_set": {"$ref": "#/$defs/identity"}}, "required": ["g2_lock", "g2_packer", "g2_public_snapshot", "g3_cost_model", "g3_schema_set"], "type": "object"},
    "final_context": {"additionalProperties": false, "properties": {"context_sha256": {"$ref": "#/$defs/hash"}, "identity": {"$ref": "#/$defs/hash"}, "items": {"items": {"$ref": "#/$defs/context_item"}, "minItems": 1, "type": "array"}, "origin_event_ids": {"items": {"$ref": "#/$defs/hash"}, "minItems": 1, "type": "array", "uniqueItems": true}}, "required": ["context_sha256", "identity", "items", "origin_event_ids"], "type": "object"},
    "fixture_input": {"additionalProperties": false, "properties": {"path": {"minLength": 1, "type": "string"}, "source": {"$ref": "#/$defs/identity"}}, "required": ["path", "source"], "type": "object"},
    "packer": {"additionalProperties": false, "properties": {"adaptive_k_application": {"$ref": "#/$defs/sealed_json"}, "adaptive_k_selected_evidence": {"$ref": "#/$defs/sealed_json"}, "graph_application": {"$ref": "#/$defs/sealed_json"}, "manifest_sources": {"items": {"$ref": "#/$defs/source"}, "minItems": 1, "type": "array"}, "pack_bytes": {"minimum": 1, "type": "integer"}, "rendered_pack_base64": {"minLength": 4, "type": "string"}, "rendered_pack_sha256": {"$ref": "#/$defs/hash"}, "selected_paths": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true}, "symbol_memory": {"$ref": "#/$defs/sealed_json"}}, "required": ["adaptive_k_application", "adaptive_k_selected_evidence", "graph_application", "manifest_sources", "pack_bytes", "rendered_pack_base64", "rendered_pack_sha256", "selected_paths", "symbol_memory"], "type": "object"},
    "receipt": {"additionalProperties": false, "properties": {"arm": {"$ref": "#/$defs/arm"}, "captured_inputs": {"$ref": "#/$defs/captured_inputs"}, "cost": {"$ref": "#/$defs/cost"}, "cost_model_sha256": {"$ref": "#/$defs/hash"}, "final_context": {"$ref": "#/$defs/final_context"}, "fixture_inputs": {"items": {"$ref": "#/$defs/fixture_input"}, "minItems": 4, "type": "array"}, "packer_receipt": {"$ref": "#/$defs/packer"}, "public_task": {"$ref": "#/$defs/sealed_json"}, "retrieval_events": {"items": {"$ref": "#/$defs/retrieval_event"}, "type": "array"}, "retrieval_plan": {"$ref": "#/$defs/plan"}, "retrieval_plan_sha256": {"$ref": "#/$defs/hash"}, "schema_version": {"const": "contextguard.g3-pre-oracle-receipt/v1", "type": "string"}, "stratum": {"$ref": "#/$defs/stratum"}, "task_id": {"$ref": "#/$defs/task"}}, "required": ["arm", "captured_inputs", "cost", "cost_model_sha256", "final_context", "fixture_inputs", "packer_receipt", "public_task", "retrieval_events", "retrieval_plan", "retrieval_plan_sha256", "schema_version", "stratum", "task_id"], "type": "object"},
    "record": {"additionalProperties": false, "properties": {"arm": {"$ref": "#/$defs/arm"}, "cost": {"$ref": "#/$defs/cost"}, "receipt": {"$ref": "#/$defs/receipt"}, "receipt_sha256": {"$ref": "#/$defs/hash"}, "schema_version": {"const": "contextguard.g3-task-arm-result/v2", "type": "string"}, "scorer_validation": {"const": "full_g2_oracle_graph_topology_adaptive_symbol_arm_passed", "type": "string"}, "stratum": {"$ref": "#/$defs/stratum"}, "task_id": {"$ref": "#/$defs/task"}}, "required": ["arm", "cost", "receipt", "receipt_sha256", "schema_version", "scorer_validation", "stratum", "task_id"], "type": "object"},
    "stratum": {"enum": ["closed_pack", "realistic_fallback"], "type": "string"},
    "task": {"pattern": "^(train|calibration|evaluation)_(closed|graph)$", "type": "string"}
  },
  "additionalProperties": false,
  "properties": {"record_count": {"const": 24, "type": "integer"}, "records": {"items": {"$ref": "#/$defs/record"}, "maxItems": 24, "minItems": 24, "type": "array"}, "schema_version": {"const": "contextguard.g3-task-arm-results/v2", "type": "string"}},
  "required": ["record_count", "records", "schema_version"],
  "type": "object"
}
