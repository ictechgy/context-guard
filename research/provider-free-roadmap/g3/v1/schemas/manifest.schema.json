{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "cost_model": {"additionalProperties": false, "properties": {"attempt_overhead_bytes": {"const": 32, "type": "integer"}, "component_formulas": {"additionalProperties": false, "properties": {"correction": {"type": "string"}, "fallback": {"type": "string"}, "fixed_overhead": {"type": "string"}, "initial_packing": {"type": "string"}, "retrieval": {"type": "string"}}, "required": ["correction", "fallback", "fixed_overhead", "initial_packing", "retrieval"], "type": "object"}, "currency": {"const": "unavailable", "type": "string"}, "fixed_overhead_per_task_arm": {"const": 256, "type": "integer"}, "formula": {"type": "string"}, "nonoverlap_rule": {"type": "string"}, "schema_version": {"const": "contextguard.g3-cost-model/v1", "type": "string"}, "units": {"const": "byte_equivalent_units", "type": "string"}}, "required": ["attempt_overhead_bytes", "component_formulas", "currency", "fixed_overhead_per_task_arm", "formula", "nonoverlap_rule", "schema_version", "units"], "type": "object"},
    "g2_source": {"additionalProperties": false, "properties": {"lock_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "tree_root_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "verifier_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}}, "required": ["lock_sha256", "tree_root_sha256", "verifier_sha256"], "type": "object"},
    "identity": {"additionalProperties": false, "properties": {"bytes": {"minimum": 0, "type": "integer"}, "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}}, "required": ["bytes", "sha256"], "type": "object"},
    "captured_inputs": {"additionalProperties": false, "properties": {"g2_lock": {"$ref": "#/$defs/identity"}, "g2_packer": {"$ref": "#/$defs/identity"}, "g2_public_snapshot": {"$ref": "#/$defs/identity"}, "g3_cost_model": {"$ref": "#/$defs/identity"}, "g3_schema_set": {"$ref": "#/$defs/identity"}}, "required": ["g2_lock", "g2_packer", "g2_public_snapshot", "g3_cost_model", "g3_schema_set"], "type": "object"},
    "task_binding": {"additionalProperties": false, "properties": {"fixture_inputs_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "public_task": {"$ref": "#/$defs/identity"}, "task_id": {"pattern": "^(train|calibration|evaluation)_(closed|graph)$", "type": "string"}}, "required": ["fixture_inputs_sha256", "public_task", "task_id"], "type": "object"},
    "packer_binding": {"additionalProperties": false, "properties": {"arm": {"enum": ["ordinary", "adaptive_only", "symbol_only", "combined"], "type": "string"}, "packer_receipt_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "task_id": {"pattern": "^(train|calibration|evaluation)_(closed|graph)$", "type": "string"}}, "required": ["arm", "packer_receipt_sha256", "task_id"], "type": "object"},
    "receipt_bindings": {"additionalProperties": false, "properties": {"captured_inputs": {"$ref": "#/$defs/captured_inputs"}, "packer_receipts": {"items": {"$ref": "#/$defs/packer_binding"}, "maxItems": 24, "minItems": 24, "type": "array", "uniqueItems": true}, "tasks": {"items": {"$ref": "#/$defs/task_binding"}, "maxItems": 6, "minItems": 6, "type": "array", "uniqueItems": true}}, "required": ["captured_inputs", "packer_receipts", "tasks"], "type": "object"},
    "range": {"additionalProperties": false, "properties": {"end": {"minimum": 1, "type": "integer"}, "start": {"minimum": 1, "type": "integer"}}, "required": ["end", "start"], "type": "object"},
    "step": {"additionalProperties": false, "properties": {"kind": {"enum": ["retrieval", "fallback", "correction"], "type": "string"}, "path": {"minLength": 1, "type": "string"}, "range": {"$ref": "#/$defs/range"}, "slice": {"$ref": "#/$defs/identity"}, "source": {"$ref": "#/$defs/identity"}}, "required": ["kind", "path", "range", "slice", "source"], "type": "object"},
    "plan": {"additionalProperties": false, "properties": {"closed_world": {"const": true, "type": "boolean"}, "fixture_tree_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "steps": {"items": {"$ref": "#/$defs/step"}, "type": "array"}, "task_id": {"pattern": "^(train|calibration|evaluation)_(closed|graph)$", "type": "string"}}, "required": ["closed_world", "fixture_tree_sha256", "steps", "task_id"], "type": "object"},
    "schemas": {"additionalProperties": false, "properties": {"aggregate_results": {"const": "aggregate-results.schema.json", "type": "string"}, "artifact_inventory": {"const": "artifact-inventory.schema.json", "type": "string"}, "event": {"const": "event.schema.json", "type": "string"}, "manifest": {"const": "manifest.schema.json", "type": "string"}, "reproducibility": {"const": "reproducibility.schema.json", "type": "string"}, "task_arm_results": {"const": "task-arm-results.schema.json", "type": "string"}, "timing_event": {"const": "timing-event.schema.json", "type": "string"}, "timing_summary": {"const": "timing-summary.schema.json", "type": "string"}}, "required": ["aggregate_results", "artifact_inventory", "event", "manifest", "reproducibility", "task_arm_results", "timing_event", "timing_summary"], "type": "object"}
  },
  "additionalProperties": false,
  "properties": {"arms": {"const": ["ordinary", "adaptive_only", "symbol_only", "combined"], "type": "array"}, "cost_model": {"$ref": "#/$defs/cost_model"}, "g2_source": {"$ref": "#/$defs/g2_source"}, "receipt_bindings": {"$ref": "#/$defs/receipt_bindings"}, "retrieval_plans": {"items": {"$ref": "#/$defs/plan"}, "maxItems": 6, "minItems": 6, "type": "array", "uniqueItems": true}, "schema_version": {"const": "contextguard.g3-rehearsal-manifest/v2", "type": "string"}, "schemas": {"$ref": "#/$defs/schemas"}},
  "required": ["arms", "cost_model", "g2_source", "receipt_bindings", "retrieval_plans", "schema_version", "schemas"],
  "type": "object"
}
