{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "context-guard-trim-output --post-tool-use-hook",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "context-guard-guard-read",
            "type": "command"
          }
        ],
        "matcher": "Read"
      }
    ]
  },
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "Write"
    ]
  }
}
