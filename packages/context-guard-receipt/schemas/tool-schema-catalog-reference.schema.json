{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {
      "const": "tool_schema_catalog_reference"
    },
    "byte_length": {
      "maximum": 900000,
      "minimum": 0,
      "type": "integer"
    },
    "capability": {
      "pattern": "^cgr1p_[A-Za-z0-9_-]{43}$",
      "type": "string"
    },
    "catalog_format": {
      "enum": [
        "anthropic_tools/v1",
        "openai_functions/v1"
      ]
    },
    "catalog_identity_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "namespace_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "contextguard-receipt-tool-schema-catalog-reference/v1"
    },
    "subject_identity_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "artifact_kind",
    "byte_length",
    "capability",
    "catalog_format",
    "catalog_identity_sha256",
    "content_sha256",
    "namespace_id",
    "schema_version",
    "subject_identity_sha256"
  ],
  "title": "Context Guard Receipt tool-schema catalog reference",
  "type": "object"
}
