{
  "$id": "https://context-guard.local/schemas/receipt-store-metadata-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence_boundary": {
      "additionalProperties": false,
      "properties": {
        "evidence_class": {"const": "companion_local_receipt_only"},
        "host_request_owned": {"const": false},
        "provider_claim_authority": {"const": false},
        "provider_join_status": {"const": "missing"},
        "runtime_observer_present": {"const": false},
        "schema_version": {"const": "contextguard-receipt-evidence-boundary/v1"},
        "selected_branch": {"const": "S2-UNSUPPORTED"},
        "selected_transport": {"const": "NONE"},
        "stage1_evidence": {"const": false},
        "stage2_evidence": {"const": false}
      },
      "required": [
        "evidence_class",
        "host_request_owned",
        "provider_claim_authority",
        "provider_join_status",
        "runtime_observer_present",
        "schema_version",
        "selected_branch",
        "selected_transport",
        "stage1_evidence",
        "stage2_evidence"
      ],
      "type": "object"
    },
    "integrity_hmac_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "limits": {
      "additionalProperties": false,
      "properties": {
        "max_artifacts": {"maximum": 1024, "minimum": 1, "type": "integer"},
        "max_capabilities": {"maximum": 1024, "minimum": 1, "type": "integer"},
        "max_single_artifact_bytes": {"maximum": 10000000, "minimum": 1, "type": "integer"},
        "max_total_artifact_bytes": {"maximum": 67108864, "minimum": 1, "type": "integer"}
      },
      "required": [
        "max_artifacts",
        "max_total_artifact_bytes",
        "max_capabilities",
        "max_single_artifact_bytes"
      ],
      "type": "object"
    },
    "namespace_id": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {"const": "contextguard-receipt-store-metadata/v1"}
  },
  "required": [
    "evidence_boundary",
    "integrity_hmac_sha256",
    "limits",
    "namespace_id",
    "schema_version"
  ],
  "title": "Context Guard Receipt private store metadata",
  "type": "object"
}
