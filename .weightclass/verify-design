#!/usr/bin/env python3
"""Prospective acceptance oracle for the follow-up design question:
what else in context-guard-kit needs fixing, and where does it conflict
operationally with the wclass-advisory tool itself?

Task (fixed before any candidate is observed): PR #315 replaced the ad-hoc
wclass-advisory Bash-route branch with a reviewed exact-name extension
registry. Now: (a) is there anything else in context-guard-kit worth
fixing, and (b) are there operational conflict points between
context-guard-kit's PreToolUse Bash hook and using wclass-advisory itself
in this repo?

This is a judgment question, so this verifier cannot grade "good taste".
What it CAN and DOES check mechanically: whether the candidate's answer
actually engages with the concrete operational friction this session hit
firsthand, rather than answering in the abstract, and whether it produces
the structurally required deliverable (>=2 real options, a concrete
recommendation, measurable acceptance criteria).
"""
from __future__ import annotations

import json
import os
import sys

EXIT_BASELINE = 42
EXIT_PASS = 0
EXIT_FAIL = 1
EXIT_INFRA = 3

REQUIRED_TOP_KEYS = {
    "schema_version",
    "mode",
    "problem",
    "summary",
    "principles",
    "options",
    "recommendation",
    "acceptance_criteria",
    "validation",
    "limitations",
}

# Concrete friction this session actually hit while using wclass-advisory
# against this repo. A design result that never engages with any of these
# is answering a generic question, not this one.
EVIDENCE_MARKERS = [
    "PROVIDER_FREE_SUPPORT_PATHS",
    "validate_provider_free_changed_paths",
    "is_legacy_production_path",
    ".weightclass",
]
OPERATIONAL_CONFLICT_MARKERS = [
    "git checkout",
    "git commit",
    "_git_is_safe",
    "sample",
    "ordinal",
    "vendor",
]


def fail(reason: str) -> int:
    print(f"verify-design: FAIL: {reason}", file=sys.stderr)
    return EXIT_FAIL


def infra(reason: str) -> int:
    print(f"verify-design: INFRA: {reason}", file=sys.stderr)
    return EXIT_INFRA


def main() -> int:
    workflow = os.environ.get("WCLASS_ADVISORY_WORKFLOW", "")
    if workflow != "design":
        return infra(f"unexpected WCLASS_ADVISORY_WORKFLOW={workflow!r}")

    raw = sys.stdin.buffer.read()
    try:
        result = json.loads(raw)
    except json.JSONDecodeError as exc:
        return infra(f"stdin is not valid JSON ({exc})")

    if not isinstance(result, dict):
        return infra("top-level result is not a JSON object")

    if (
        result.get("recommendation") == "Reject this task-free probe with exit code 42."
        and "baseline_probe" in (result.get("limitations") or [])
    ):
        return EXIT_BASELINE

    missing_keys = REQUIRED_TOP_KEYS - set(result)
    if missing_keys:
        return fail(f"missing required keys: {sorted(missing_keys)}")

    options = result.get("options")
    if not isinstance(options, list) or len(options) < 2:
        return fail("fewer than 2 concrete options were presented")
    for index, option in enumerate(options):
        if not isinstance(option, dict):
            return fail(f"options[{index}] is not an object")
        for field in ("title", "rationale", "strengths", "risks", "affected_surfaces"):
            value = option.get(field)
            if not value:
                return fail(f"options[{index}].{field} is empty")

    recommendation = result.get("recommendation")
    if not isinstance(recommendation, str) or len(recommendation.strip()) < 20:
        return fail("recommendation is missing or too thin to be actionable")

    acceptance_criteria = result.get("acceptance_criteria")
    if not isinstance(acceptance_criteria, list) or len(acceptance_criteria) < 2:
        return fail("fewer than 2 measurable acceptance criteria were given")

    blob = json.dumps(result, ensure_ascii=False)
    matched_evidence = [marker for marker in EVIDENCE_MARKERS if marker in blob]
    if not matched_evidence:
        return fail(
            "result never cites any of the task's concrete friction markers "
            f"{EVIDENCE_MARKERS} - looks like a generic answer, not this task"
        )

    matched_conflicts = [marker for marker in OPERATIONAL_CONFLICT_MARKERS if marker in blob]
    if not matched_conflicts:
        return fail(
            "result never engages with the operational-conflict-with-wclass-advisory "
            f"angle {OPERATIONAL_CONFLICT_MARKERS} - the task asked for both a "
            "further-fixes assessment AND an operational-conflict assessment"
        )

    print(
        "verify-design: PASS "
        f"(evidence={matched_evidence}, conflicts={matched_conflicts}, "
        f"options={len(options)})",
        file=sys.stderr,
    )
    return EXIT_PASS


if __name__ == "__main__":
    raise SystemExit(main())
