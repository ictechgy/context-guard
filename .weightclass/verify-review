#!/usr/bin/env python3
"""Prospective acceptance oracle for the review of the runner-aware
pass/fail digest summary branch (feat/trim-runner-result-summary, PR #324)
on context-guard-kit.

Task (fixed before any candidate is observed): review the diff between
`main` and this branch for correctness and security. The diff adds
`RunnerResultSummary`, a small class in
context-guard-kit/trim_command_output.py (and its byte-identical mirror
plugins/context-guard/bin/context-guard-trim-output) that recognizes
pytest's and cargo test's own terminal aggregate summary line (not
per-test lines) and surfaces it as a new, purely additive
`runner_result_summary` digest field, populated regardless of exit code.

Particular attention should go to:
- Whether the regex matching is anchored/bounded enough to avoid false
  positives on ordinary output that happens to contain digit-count-word
  patterns (e.g. could arbitrary program output accidentally match
  PYTEST_SUMMARY_RE or CARGO_RESULT_RE and produce a misleading summary?).
- Whether the pytest terminal-width "=" banner stripping
  (`stripped.strip("= ")`) is correct and doesn't corrupt raw_line or
  accidentally strip meaningful "=" or space characters from a summary
  line that isn't actually banner-padded.
- Whether every existing digest field (status, exit_code, raw_output,
  representative_head/tail, runner_failure_summary, failure_signature,
  duplicate_line_groups, next_queries) is genuinely unchanged in both
  presence and content - this must be purely additive.
- Whether the two mirrored files (context-guard-kit/trim_command_output.py
  and plugins/context-guard/bin/context-guard-trim-output) are still
  byte-identical.
- Whether tests/test_contextguard_stage2_feasibility.py's
  PROVIDER_FREE_SUPPORT_PATHS addition is the only frozen-baseline change
  needed here (this file has none of the deeper cascading hash pins that
  applied to a prior receipt-package change in this repository's history).

This is a judgment task, so this verifier cannot grade review quality
directly. What it CAN and DOES check mechanically: that findings are
grounded in the real changed file set (not hallucinated paths), that the
review explicitly engages with the changed regex/matching logic, and that
it produces a real verdict rather than a vague non-answer.
"""
from __future__ import annotations

import json
import os
import sys

EXIT_BASELINE = 42
EXIT_PASS = 0
EXIT_FAIL = 1
EXIT_INFRA = 3

REQUIRED_TOP_KEYS = {"schema_version", "mode", "summary", "findings", "limitations"}

CHANGED_FILES = {
    ".weightclass/verify",
    "context-guard-kit/trim_command_output.py",
    "plugins/context-guard/bin/context-guard-trim-output",
    "tests/test_contextguard_stage2_feasibility.py",
    "tests/test_runner_result_summary_digest.py",
}

CORE_LOGIC_MARKERS = [
    "RunnerResultSummary",
    "PYTEST_SUMMARY_RE",
    "PYTEST_COUNT_PAIR_RE",
    "CARGO_RESULT_RE",
    "runner_result_summary",
    "raw_line",
    "strip(\"= \")",
    "strip('= ')",
    "banner",
]


def fail(reason: str) -> int:
    print(f"verify-review: FAIL: {reason}", file=sys.stderr)
    return EXIT_FAIL


def infra(reason: str) -> int:
    print(f"verify-review: INFRA: {reason}", file=sys.stderr)
    return EXIT_INFRA


def finding_text(finding: object) -> str:
    if isinstance(finding, str):
        return finding
    if isinstance(finding, dict):
        return " ".join(str(value) for value in finding.values())
    return str(finding)


def main() -> int:
    workflow = os.environ.get("WCLASS_ADVISORY_WORKFLOW", "")
    if workflow != "review":
        return infra(f"unexpected WCLASS_ADVISORY_WORKFLOW={workflow!r}")

    raw = sys.stdin.buffer.read()
    try:
        result = json.loads(raw)
    except json.JSONDecodeError as exc:
        return infra(f"stdin is not valid JSON ({exc})")

    if not isinstance(result, dict):
        return infra("top-level result is not a JSON object")

    if (
        result.get("summary") == "Prospective baseline probe; no task was evaluated."
        and "baseline_probe" in (result.get("limitations") or [])
    ):
        return EXIT_BASELINE

    missing_keys = REQUIRED_TOP_KEYS - set(result)
    if missing_keys:
        return fail(f"missing required keys: {sorted(missing_keys)}")

    findings = result.get("findings")
    if not isinstance(findings, list):
        return fail("findings must be a list")

    summary = result.get("summary")
    if not isinstance(summary, str) or len(summary.strip()) < 20:
        return fail("summary is missing or too thin to be a real verdict")

    blob = json.dumps(result, ensure_ascii=False)
    engaged_core_logic = any(marker in blob for marker in CORE_LOGIC_MARKERS)
    if not engaged_core_logic:
        return fail(
            "review never mentions any of the changed core concerns "
            f"{CORE_LOGIC_MARKERS} - looks like a generic review, not this diff"
        )

    if not findings:
        no_issues_language = any(
            token in summary.lower()
            for token in ("no blocking", "no issue", "no finding", "clean", "sound", "correct")
        )
        if not no_issues_language:
            return fail(
                "empty findings list without an explicit clean-bill-of-health "
                "statement in the summary"
            )
        print("verify-review: PASS (explicit clean verdict, no findings)", file=sys.stderr)
        return EXIT_PASS

    grounded = 0
    for index, finding in enumerate(findings):
        text = finding_text(finding)
        if any(path in text for path in CHANGED_FILES):
            grounded += 1
        else:
            print(
                f"verify-review: finding[{index}] cites no path from the "
                "actual changed file set - possibly hallucinated",
                file=sys.stderr,
            )
    if grounded == 0:
        return fail(
            "no finding cites any path from the real changed file set "
            f"{sorted(CHANGED_FILES)}"
        )

    print(
        f"verify-review: PASS ({len(findings)} finding(s), {grounded} grounded "
        "in the real changed file set)",
        file=sys.stderr,
    )
    return EXIT_PASS


if __name__ == "__main__":
    raise SystemExit(main())
