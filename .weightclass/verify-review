#!/usr/bin/env python3
"""Prospective acceptance oracle for the review of the receipt_expand
task_scope binding branch (feat/receipt-expand-task-scope, PR #323) on
context-guard-kit.

Task (fixed before any candidate is observed): review the diff between
`main` and this branch for correctness and security. The diff has two
concerns:

1. The functional change: `receipt_expand` (an MCP tool in
   packages/context-guard-receipt/python/context_guard_receipt/mcp.py)
   gains an optional task_scope binding, mirroring receipt_context's
   existing scope mechanism (MCPServer._lease_matches/_task_scope_hmac).
   A new `scope_hmac_sha256: str | None = None` field was added to
   ArtifactRequest/StoredArtifact in store.py (default None, no current
   issuer populates it). MCPServer._expand() now accepts an optional
   task_scope argument and rejects (capability_rejected) any mismatch,
   including a task_scope supplied against an unscoped capability.
   Particular attention should go to whether the scope-matching logic
   (_scope_hmac_matches) is actually reached before any capability
   content is used, and whether it correctly fails closed in every
   branch (unscoped capability + supplied scope; scoped capability +
   missing/wrong scope; the _tool_references code path, which has no
   underlying scope storage at all).
2. A long chain of cascading frozen-hash updates this change triggered:
   mcp.py/store.py's own pinned hashes in
   tests/test_contextguard_stage2_feasibility.py's RECEIPT_COMPANION_INVENTORY
   and packages/context-guard-receipt/package-files.json; package-files.json's
   own hash cascading into tests/test_release_assets.py and both
   bash_reference_policy.py mirrors; and launcher.cjs's TRUSTED_PAYLOAD_DIGESTS
   entries (a separate runtime integrity check, distinct from the Python
   test pins), which in turn changed launcher.cjs's own bytes and cascaded
   once more back into package-files.json's own entry for launcher.cjs.
   Review whether every one of these pinned hashes actually matches the
   current file bytes (a stale entry would either fail CI immediately or,
   worse, silently pin the WRONG bytes if a hash was copied from the wrong
   file/step).

This is a judgment task, so this verifier cannot grade review quality
directly. What it CAN and DOES check mechanically: that findings are
grounded in the real changed file set (not hallucinated paths), that the
review explicitly engages with the changed scope-binding logic, and that
it produces a real verdict rather than a vague non-answer.
"""
from __future__ import annotations

import json
import os
import sys

EXIT_BASELINE = 42
EXIT_PASS = 0
EXIT_FAIL = 1
EXIT_INFRA = 3

REQUIRED_TOP_KEYS = {"schema_version", "mode", "summary", "findings", "limitations"}

CHANGED_FILES = {
    ".weightclass/verify",
    "context-guard-kit/bash_reference_policy.py",
    "packages/context-guard-receipt/bin/launcher.cjs",
    "packages/context-guard-receipt/package-files.json",
    "packages/context-guard-receipt/python/context_guard_receipt/mcp.py",
    "packages/context-guard-receipt/python/context_guard_receipt/store.py",
    "packages/context-guard-receipt/tests/contract/test_g012_mcp_expand_scope.py",
    "plugins/context-guard/bin/bash_reference_policy.py",
    "tests/test_contextguard_stage2_feasibility.py",
    "tests/test_release_assets.py",
}

CORE_LOGIC_MARKERS = [
    "_expand",
    "_scope_hmac_matches",
    "_task_scope_hmac",
    "scope_hmac_sha256",
    "task_scope",
    "ArtifactRequest",
    "StoredArtifact",
    "TRUSTED_PAYLOAD_DIGESTS",
    "RECEIPT_COMPANION_INVENTORY",
]


def fail(reason: str) -> int:
    print(f"verify-review: FAIL: {reason}", file=sys.stderr)
    return EXIT_FAIL


def infra(reason: str) -> int:
    print(f"verify-review: INFRA: {reason}", file=sys.stderr)
    return EXIT_INFRA


def finding_text(finding: object) -> str:
    if isinstance(finding, str):
        return finding
    if isinstance(finding, dict):
        return " ".join(str(value) for value in finding.values())
    return str(finding)


def main() -> int:
    workflow = os.environ.get("WCLASS_ADVISORY_WORKFLOW", "")
    if workflow != "review":
        return infra(f"unexpected WCLASS_ADVISORY_WORKFLOW={workflow!r}")

    raw = sys.stdin.buffer.read()
    try:
        result = json.loads(raw)
    except json.JSONDecodeError as exc:
        return infra(f"stdin is not valid JSON ({exc})")

    if not isinstance(result, dict):
        return infra("top-level result is not a JSON object")

    if (
        result.get("summary") == "Prospective baseline probe; no task was evaluated."
        and "baseline_probe" in (result.get("limitations") or [])
    ):
        return EXIT_BASELINE

    missing_keys = REQUIRED_TOP_KEYS - set(result)
    if missing_keys:
        return fail(f"missing required keys: {sorted(missing_keys)}")

    findings = result.get("findings")
    if not isinstance(findings, list):
        return fail("findings must be a list")

    summary = result.get("summary")
    if not isinstance(summary, str) or len(summary.strip()) < 20:
        return fail("summary is missing or too thin to be a real verdict")

    blob = json.dumps(result, ensure_ascii=False)
    engaged_core_logic = any(marker in blob for marker in CORE_LOGIC_MARKERS)
    if not engaged_core_logic:
        return fail(
            "review never mentions any of the changed core concerns "
            f"{CORE_LOGIC_MARKERS} - looks like a generic review, not this diff"
        )

    if not findings:
        no_issues_language = any(
            token in summary.lower()
            for token in ("no blocking", "no issue", "no finding", "clean", "sound", "correct")
        )
        if not no_issues_language:
            return fail(
                "empty findings list without an explicit clean-bill-of-health "
                "statement in the summary"
            )
        print("verify-review: PASS (explicit clean verdict, no findings)", file=sys.stderr)
        return EXIT_PASS

    grounded = 0
    for index, finding in enumerate(findings):
        text = finding_text(finding)
        if any(path in text for path in CHANGED_FILES):
            grounded += 1
        else:
            print(
                f"verify-review: finding[{index}] cites no path from the "
                "actual changed file set - possibly hallucinated",
                file=sys.stderr,
            )
    if grounded == 0:
        return fail(
            "no finding cites any path from the real changed file set "
            f"{sorted(CHANGED_FILES)}"
        )

    print(
        f"verify-review: PASS ({len(findings)} finding(s), {grounded} grounded "
        "in the real changed file set)",
        file=sys.stderr,
    )
    return EXIT_PASS


if __name__ == "__main__":
    raise SystemExit(main())
