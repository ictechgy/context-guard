#!/usr/bin/env python3
"""Prospective acceptance oracle for the review of the two optional
follow-ups on context-guard-kit: argparse "--flag=value" support in
`_wclass_advisory_is_safe`, and a canonical command + preflight checklist
in `docs/wclass-advisory-workflow.md`.

Task (fixed before any candidate is observed): review the diff between
`main` and this branch (four files: the two Bash-hook mirrors,
`docs/wclass-advisory-workflow.md`, and
`tests/test_wclass_advisory_extension_predicate.py`) for correctness and
security, with particular attention to whether the equals-syntax predicate
actually stays as strict as the separated form, not just as permissive.

This is a judgment task, so this verifier cannot grade review quality
directly. What it CAN and DOES check mechanically: that findings are
grounded in the real changed file set (not hallucinated paths), that the
review explicitly engages with the changed predicate function
(`_wclass_advisory_is_safe`), and that it produces a real verdict rather
than a vague non-answer.
"""
from __future__ import annotations

import json
import os
import sys

EXIT_BASELINE = 42
EXIT_PASS = 0
EXIT_FAIL = 1
EXIT_INFRA = 3

REQUIRED_TOP_KEYS = {"schema_version", "mode", "summary", "findings", "limitations"}

CHANGED_FILES = {
    "context-guard-kit/rewrite_bash_for_token_budget.py",
    "plugins/context-guard/bin/context-guard-rewrite-bash",
    "docs/wclass-advisory-workflow.md",
    "tests/test_wclass_advisory_extension_predicate.py",
}

CORE_LOGIC_MARKERS = [
    "_wclass_advisory_is_safe",
]


def fail(reason: str) -> int:
    print(f"verify-review: FAIL: {reason}", file=sys.stderr)
    return EXIT_FAIL


def infra(reason: str) -> int:
    print(f"verify-review: INFRA: {reason}", file=sys.stderr)
    return EXIT_INFRA


def finding_text(finding: object) -> str:
    if isinstance(finding, str):
        return finding
    if isinstance(finding, dict):
        return " ".join(str(value) for value in finding.values())
    return str(finding)


def main() -> int:
    workflow = os.environ.get("WCLASS_ADVISORY_WORKFLOW", "")
    if workflow != "review":
        return infra(f"unexpected WCLASS_ADVISORY_WORKFLOW={workflow!r}")

    raw = sys.stdin.buffer.read()
    try:
        result = json.loads(raw)
    except json.JSONDecodeError as exc:
        return infra(f"stdin is not valid JSON ({exc})")

    if not isinstance(result, dict):
        return infra("top-level result is not a JSON object")

    if (
        result.get("summary") == "Prospective baseline probe; no task was evaluated."
        and "baseline_probe" in (result.get("limitations") or [])
    ):
        return EXIT_BASELINE

    missing_keys = REQUIRED_TOP_KEYS - set(result)
    if missing_keys:
        return fail(f"missing required keys: {sorted(missing_keys)}")

    findings = result.get("findings")
    if not isinstance(findings, list):
        return fail("findings must be a list")

    summary = result.get("summary")
    if not isinstance(summary, str) or len(summary.strip()) < 20:
        return fail("summary is missing or too thin to be a real verdict")

    blob = json.dumps(result, ensure_ascii=False)
    engaged_core_logic = any(marker in blob for marker in CORE_LOGIC_MARKERS)
    if not engaged_core_logic:
        return fail(
            "review never mentions the changed predicate "
            f"{CORE_LOGIC_MARKERS} - looks like a generic review, not this diff"
        )

    if not findings:
        no_issues_language = any(
            token in summary.lower()
            for token in ("no blocking", "no issue", "no finding", "clean", "sound", "correct")
        )
        if not no_issues_language:
            return fail(
                "empty findings list without an explicit clean-bill-of-health "
                "statement in the summary"
            )
        print("verify-review: PASS (explicit clean verdict, no findings)", file=sys.stderr)
        return EXIT_PASS

    grounded = 0
    for index, finding in enumerate(findings):
        text = finding_text(finding)
        if any(path in text for path in CHANGED_FILES):
            grounded += 1
        else:
            print(
                f"verify-review: finding[{index}] cites no path from the "
                "actual changed file set - possibly hallucinated",
                file=sys.stderr,
            )
    if grounded == 0:
        return fail(
            "no finding cites any path from the real changed file set "
            f"{sorted(CHANGED_FILES)}"
        )

    print(
        f"verify-review: PASS ({len(findings)} finding(s), {grounded} grounded "
        "in the real changed file set)",
        file=sys.stderr,
    )
    return EXIT_PASS


if __name__ == "__main__":
    raise SystemExit(main())
