#!/usr/bin/env python3
"""Prospective acceptance oracle for the review of the broad
security/architecture/performance audit hardening branch
(weightclass-broad-audit-fixes, PR #318) on context-guard-kit.

Task (fixed before any candidate is observed): review the diff between
`main` (99ee017) and this branch for correctness and security. The diff
spans three concerns:

1. Three security fixes in context-guard-kit (+ byte-identical plugin
   mirrors): fixed-path `git` resolution in `run_guarded_git()`
   (closing a PATH-hijack surface), `FallbackLineSanitizer` coverage
   for PEM private-key blocks / Cookie headers / userinfo credentials
   in `trim_command_output.py`, and `O_NOFOLLOW` symlink-swap hardening
   in `_isolated_wrapper_prefix()`.
2. A formal Gate-B gen12 bless/reapply/register ceremony
   (`scripts/verify_gate_b_rollback.py`,
   `tests/test_gate_b_rollback_proof.py`) proving the shared-integration
   component change was applied through the documented 4-commit
   ceremony rather than bypassing it.
3. A two-commit v4 live-roadmap core-commit activation ceremony
   (`research/provider-live-roadmap/p3-api/v4/live_launcher.py`,
   `live_runner.py`, `live-contract.json`,
   `tests/provider-live-roadmap/test_p3_anthropic_api_v4.py`) repointing
   cascaded sanitizer/contract digest pins after the
   `sanitize_output.py` docstring fix, with particular attention to
   whether `EXPECTED_CORE_COMMIT`/`EXPECTED_RUNNER_SHA256`/
   `EXPECTED_CONTRACT_SHA256` are mutually consistent and whether the
   test's hardcoded core-commit assertion was updated to match.

This is a judgment task, so this verifier cannot grade review quality
directly. What it CAN and DOES check mechanically: that findings are
grounded in the real changed file set (not hallucinated paths), that
the review explicitly engages with at least one of the three concerns
above, and that it produces a real verdict rather than a vague
non-answer.
"""
from __future__ import annotations

import json
import os
import sys

EXIT_BASELINE = 42
EXIT_PASS = 0
EXIT_FAIL = 1
EXIT_INFRA = 3

REQUIRED_TOP_KEYS = {"schema_version", "mode", "summary", "findings", "limitations"}

CHANGED_FILES = {
    ".weightclass/verify",
    "context-guard-kit/rewrite_bash_for_token_budget.py",
    "context-guard-kit/sanitize_output.py",
    "context-guard-kit/trim_command_output.py",
    "docs/release-runbook.md",
    "plugins/context-guard/bin/context-guard-rewrite-bash",
    "plugins/context-guard/bin/context-guard-sanitize-output",
    "plugins/context-guard/bin/context-guard-trim-output",
    "research/provider-live-roadmap/p3-api/v4/live-contract.json",
    "research/provider-live-roadmap/p3-api/v4/live_launcher.py",
    "research/provider-live-roadmap/p3-api/v4/live_runner.py",
    "scripts/verify_gate_b_rollback.py",
    "tests/provider-live-roadmap/test_p3_anthropic_api_v4.py",
    "tests/test_broad_audit_hardening.py",
    "tests/test_context_guard_kit.py",
    "tests/test_contextguard_stage2_feasibility.py",
    "tests/test_gate_b_rollback_proof.py",
}

CORE_LOGIC_MARKERS = [
    "run_guarded_git",
    "_approved_runtime_executable",
    "FallbackLineSanitizer",
    "_isolated_wrapper_prefix",
    "UnsafeAdjacentWrapperError",
    "gen12",
    "EXPECTED_CORE_COMMIT",
    "EXPECTED_RUNNER_SHA256",
    "EXPECTED_CONTRACT_SHA256",
    "_verify_core_commit",
]


def fail(reason: str) -> int:
    print(f"verify-review: FAIL: {reason}", file=sys.stderr)
    return EXIT_FAIL


def infra(reason: str) -> int:
    print(f"verify-review: INFRA: {reason}", file=sys.stderr)
    return EXIT_INFRA


def finding_text(finding: object) -> str:
    if isinstance(finding, str):
        return finding
    if isinstance(finding, dict):
        return " ".join(str(value) for value in finding.values())
    return str(finding)


def main() -> int:
    workflow = os.environ.get("WCLASS_ADVISORY_WORKFLOW", "")
    if workflow != "review":
        return infra(f"unexpected WCLASS_ADVISORY_WORKFLOW={workflow!r}")

    raw = sys.stdin.buffer.read()
    try:
        result = json.loads(raw)
    except json.JSONDecodeError as exc:
        return infra(f"stdin is not valid JSON ({exc})")

    if not isinstance(result, dict):
        return infra("top-level result is not a JSON object")

    if (
        result.get("summary") == "Prospective baseline probe; no task was evaluated."
        and "baseline_probe" in (result.get("limitations") or [])
    ):
        return EXIT_BASELINE

    missing_keys = REQUIRED_TOP_KEYS - set(result)
    if missing_keys:
        return fail(f"missing required keys: {sorted(missing_keys)}")

    findings = result.get("findings")
    if not isinstance(findings, list):
        return fail("findings must be a list")

    summary = result.get("summary")
    if not isinstance(summary, str) or len(summary.strip()) < 20:
        return fail("summary is missing or too thin to be a real verdict")

    blob = json.dumps(result, ensure_ascii=False)
    engaged_core_logic = any(marker in blob for marker in CORE_LOGIC_MARKERS)
    if not engaged_core_logic:
        return fail(
            "review never mentions any of the changed core concerns "
            f"{CORE_LOGIC_MARKERS} - looks like a generic review, not this diff"
        )

    if not findings:
        no_issues_language = any(
            token in summary.lower()
            for token in ("no blocking", "no issue", "no finding", "clean", "sound", "correct")
        )
        if not no_issues_language:
            return fail(
                "empty findings list without an explicit clean-bill-of-health "
                "statement in the summary"
            )
        print("verify-review: PASS (explicit clean verdict, no findings)", file=sys.stderr)
        return EXIT_PASS

    grounded = 0
    for index, finding in enumerate(findings):
        text = finding_text(finding)
        if any(path in text for path in CHANGED_FILES):
            grounded += 1
        else:
            print(
                f"verify-review: finding[{index}] cites no path from the "
                "actual changed file set - possibly hallucinated",
                file=sys.stderr,
            )
    if grounded == 0:
        return fail(
            "no finding cites any path from the real changed file set "
            f"{sorted(CHANGED_FILES)}"
        )

    print(
        f"verify-review: PASS ({len(findings)} finding(s), {grounded} grounded "
        "in the real changed file set)",
        file=sys.stderr,
    )
    return EXIT_PASS


if __name__ == "__main__":
    raise SystemExit(main())
