#!/bin/sh
set -eu

if ! git diff --cached --quiet -- .weightclass/verify tests/test_user_settings_permissions.py; then
  echo "protected acceptance files changed"
  exit 1
fi

set +e
CONTEXT_GUARD_CAMPAIGN_ACCEPTANCE=1 \
  python3 -m unittest tests.test_user_settings_permissions
focused_code=$?
set -e

if [ "$focused_code" -eq 0 ]; then
  python3 -m unittest \
    tests.test_context_guard_kit_benchmark_surfaces.CrossAgentAdapterTests.test_user_scope_claude_writes_home_settings_with_rollback_record \
    tests.test_context_guard_kit_benchmark_surfaces.CrossAgentAdapterTests.test_user_scope_existing_claude_settings_rejects_no_backup \
    tests.test_home_settings_alias_scope
  python3 -m compileall -q context-guard-kit plugins/context-guard/bin tests
  exit 0
fi

if [ "$focused_code" -ne 1 ]; then
  exit 1
fi

python3 -m unittest \
  tests.test_context_guard_kit_benchmark_surfaces.CrossAgentAdapterTests.test_user_scope_claude_writes_home_settings_with_rollback_record \
  tests.test_context_guard_kit_benchmark_surfaces.CrossAgentAdapterTests.test_user_scope_existing_claude_settings_rejects_no_backup \
  tests.test_home_settings_alias_scope
python3 -m compileall -q context-guard-kit plugins/context-guard/bin tests
exit 42
